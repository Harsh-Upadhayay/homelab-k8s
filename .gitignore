# Terraform — generalized for the terraform/<component>/ layout (bootstrap, proxmox, aws, ...)
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.*
# terraform.tfvars is intentionally NOT ignored — it holds only non-secret
# values (region, bucket name, host specs). Secrets reach Terraform via env
# vars (PROXMOX_VE_API_TOKEN) or TF_VAR_* (ephemeral, value_wo), never tfvars.

# Ansible
ansible/*.retry
.env

# Kubeconfig pulled from the cluster
kubeconfig
*.kubeconfig

# Stray shell redirect artifacts at repo root (caught one holding a live
# OAuth client secret - never intentional, never meant to be tracked)
/*.log

# Claude Code worktrees (EnterWorktree) - local scratch checkouts, never meant
# to be tracked as gitlinks in the main repo's history
.claude/worktrees/

# Scratch notes (e.g. hardware-shopping research) - not part of the platform
.scratch/
